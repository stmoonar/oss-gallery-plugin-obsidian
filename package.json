{
	"name": "oss-gallery",
	"version": "2.0.1",
	"description": "Upload and manage media and documents across multiple OSS providers for Obsidian.",
	"main": "main.js",
	"type": "module",
	"packageManager": "pnpm@10.34.6",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian-plugin",
		"obsidian",
		"oss",
		"upload",
		"gallery",
		"s3",
		"image-hosting"
	],
	"author": "stmoonar",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/aws4": "^1.11.6",
		"@types/node": "^22.20.5",
		"esbuild": "0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.71.0"
	},
	"dependencies": {
		"aws4": "^1.13.2",
		"js-base64": "^3.9.4",
		"mime": "^4.1.0"
	}
}
